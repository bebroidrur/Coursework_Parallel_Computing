@startuml
title Parallel build: implemented Java API
actor Caller
participant IndexBuilder as Builder
participant "ExecutorService (N threads)" as Pool
participant "Worker tasks" as Workers
participant "New InvertedIndex" as Index
participant "Bucket monitor" as Bucket
Caller -> Builder: buildParallel(documents, N)
activate Builder
Builder -> Builder: validate N, copy input, register unique document IDs
Builder -> Pool: newFixedThreadPool(N)
loop min(N, document count) tasks
 Builder -> Pool: submit strided document partition
end
par workers
 Pool -> Workers: process documents
 Workers -> Workers: check interruption; tokenize
 loop terms
  Workers -> Index: addRegisteredTerm(term, docId)
  Index -> Bucket: synchronized insert
 end
end
Builder -> Pool: completion.take().get() for all tasks
alt all workers successful
 Builder -> Pool: shutdownNow(); close() waits for termination
 Builder -> Builder: publish volatile BuildSnapshot(index, elapsed, N)
 Builder --> Caller: complete
else worker failure or caller interruption
 Builder -> Pool: shutdownNow(); close() waits for termination
 Builder -> Builder: retain previous snapshot; preserve interrupt flag
 Builder --> Caller: IndexBuildException with cause
end
deactivate Builder
@enduml
